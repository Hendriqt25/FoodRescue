{
  "name": "foodrescue-api",
  "version": "1.0.0",
  "description": "RESTful API FoodRescue tahap awal: koneksi Express.js ke MongoDB Atlas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ai": "python -m uvicorn main:app --reload --port 8000 --app-dir ML",
    "dev": "concurrently -n API,AI -c blue,green \"npm run start\" \"npm run ai\"",
    "import": "node seed/importDataset.js"
  },
  "keywords": [
    "foodrescue",
    "nodejs",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.24.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.14"
  },
  "type": "commonjs"
}
